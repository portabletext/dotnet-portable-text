<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>default</LangVersion>
    <RootNamespace>PortableText</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- compare.sh sets PortableTextBaselineVersion for the "Base" job, which then uses a package built from the base commit -->
  <ItemGroup Condition="'$(PortableTextBaselineVersion)' == ''">
    <ProjectReference Include="..\src\PortableText\PortableText.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PortableTextBaselineVersion)' != ''">
    <PackageReference Include="PortableText" Version="[$(PortableTextBaselineVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="data\bigcontent.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
