<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PortableText</RootNamespace>
    <LangVersion>default</LangVersion>
    <AssemblyName>PortableText</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PortableText</PackageId>
    <PackageDescription>
      This library contains tools for serializing Portable Text to HTML.
    </PackageDescription>
    <PackageTags>Portable Text</PackageTags>
    <Authors>saasen</Authors>
  </PropertyGroup>

  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
