<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>PortableText</RootNamespace>
    <LangVersion>default</LangVersion>
    <AssemblyName>PortableText</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PortableText</PackageId>
    <VersionPrefix>2.0.0</VersionPrefix>
    <PackageDescription>
      This library contains tools for serializing Portable Text to HTML.
    </PackageDescription>
    <PackageTags>Portable Text</PackageTags>
    <Authors>saasen</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/portabletext/dotnet-portable-text</PackageProjectUrl>
    <RepositoryUrl>https://github.com/portabletext/dotnet-portable-text</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

</Project>
